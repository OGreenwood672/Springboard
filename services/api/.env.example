# Springboard UK API Configuration
PROJECT_NAME="Springboard UK API"
ENVIRONMENT="development"

# Database connection string (PostgreSQL 16 + PostGIS 3.4)
# Note: If PostgreSQL is not running, the application automatically falls back to standalone SQLite (springboard.db).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/springboard_db"

# JWT Security
JWT_SECRET_KEY="springboard-super-secret-uk-mvp-key-change-in-prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini API Key (Optional: leave blank for deterministic offline mock agent mode)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Semantic skill inference is activated when GEMINI_API_KEY is configured.
SEMANTIC_SKILLS_ENABLED=true
SEMANTIC_EMBEDDING_DIMENSIONS=768
SEMANTIC_ALIAS_THRESHOLD=0.96
SEMANTIC_RELATIONSHIP_THRESHOLD=0.72
SEMANTIC_EMBEDDING_EDGE_THRESHOLD=0.84
SEMANTIC_EMBEDDING_NEIGHBOURS=5
SEMANTIC_MODEL_RELATIONSHIP_THRESHOLD=0.65
SEMANTIC_CATEGORY_THRESHOLD=0.90
