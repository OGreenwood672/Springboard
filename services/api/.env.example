# Springboard UK API Configuration
PROJECT_NAME="Springboard UK API"
ENVIRONMENT="development"

# Database connection string (PostgreSQL 16 + PostGIS 3.4)
# Note: If PostgreSQL is not running, the application automatically falls back to standalone SQLite (springboard.db).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/springboard_db"

# JWT Security
JWT_SECRET_KEY="springboard-super-secret-uk-mvp-key-change-in-prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini API Key (Optional: leave blank for deterministic offline mock agent mode)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

