{
  "name": "springboard-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @springboard/web dev",
    "build:web": "pnpm --filter @springboard/shared-types build && pnpm --filter @springboard/web build",
    "test:web": "pnpm --filter @springboard/web test",
    "dev:council": "pnpm --filter @springboard/council dev",
    "build:council": "pnpm --filter @springboard/council build",
    "test:council": "pnpm --filter @springboard/council test",
    "build:types": "pnpm --filter @springboard/shared-types build",
    "dev:api": "cd services/api && uvicorn app.main:app --reload --port 8000",
    "start:api": "cd services/api && uvicorn app.main:app --port 8000",
    "test:api": "cd services/api && .\\.venv\\Scripts\\pytest.exe"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
