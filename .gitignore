# ==============================================================================
# Springboard Monorepo — Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.test.example
*.env
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# Databases & Local Storage
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
springboard.db
springboard_test.db

# ------------------------------------------------------------------------------
# Python & Backend (FastAPI / SQLAlchemy / Pytest)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
.venv/
venv/
ENV/
env/

# Python packaging & distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Pytest, coverage & static analysis
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Node.js, Frontend & Build Tooling (React / Vite / TypeScript / pnpm)
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
dist/
dist-ssr/
*.local
.npmrc

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite & cache
.vite/
.turbo/
.cache/

# Testing coverage (Vitest / Jest)
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# VS Code (ignore workspace state, keep recommendations if needed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (PyCharm / WebStorm / IDEA)
.idea/
*.iws
*.iml
*.ipr

# Miscellaneous editors
*.swp
*.swo
*~
